# InvisiProxy LTS — server-only settings (.env)
#
# Copy this file to .env and uncomment what you need; everything here is
# optional and a fresh clone runs without it. Variables already set in the
# environment win over config.json.
#
# The split is deliberate:
#   config.json  what the site IS — branding, build behavior, features.
#                Committed to the repo.
#   .env         where it RUNS — per-deployment ports, addresses, secrets.
#                Gitignored; copy this file to start.
#   private/     server data files — the mirror link list, ad config.

## Site
# The port the site listens on (default: the port from config.json, 8080).
#PORT=8080

## Wisp (finalwisp)
# Path to the finalwisp binary, if it is not /usr/local/bin/finalwisp or on
# PATH.
#FINALWISP_BIN=/usr/local/bin/finalwisp

# One finalwisp instance runs per region. Each port moves on its own; set a
# whole second (or third) site instance to its own block here. Defaults
# shown.
#FINALWISP_PORT=6001
#FINALWISP_TOR_PORT=6002
#FINALWISP_EU_PORT=6003
#FINALWISP_JP_PORT=6004
#FINALWISP_PATREON_PORT=6005

# How the Wisp instances resolve hostnames: resolve (default), lookup, or a
# provider such as nextdns:3192c1 / 3192c1.dns.nextdns.io.
#DNS=resolve

## Region proxies
# The Patreon region's upstream proxy. A user:password in this URL is visible
# in the process list; prefer a private finalwisp config file for
# authenticated proxies (see FINALWISP.md).
#PATREON_PROXY=socks5h://127.0.0.1:7002

## WebRTC relay (only with dlpcc on in config.json)
# A host pattern giving every mirror its own TURN name, e.g. turn.*.
#DLPCC_PUBLIC_HOST=turn.*
# true when NGINX owns 443 and hands TURN to the relay via its stream config
# (the env form of dlpccNginx in config.json).
#DLPCC_NGINX=true
# Relay limits (defaults shown; the dlpcc package reads these itself).
#DLPCC_RATE_LIMIT=600
#DLPCC_RATE_LIMIT_BURST=100
#DLPCC_MAX_ALLOCS_PER_USER=32
#DLPCC_MAX_ALLOCS=4000
